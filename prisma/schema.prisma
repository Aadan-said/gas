// GasFlow Petroleum Station Management System — Enterprise Prisma Schema
// Supports PostgreSQL (Production / Neon / Supabase Cloud Sync) and Edge Architecture

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 1. USERS & ACCESS CONTROL ─────────────────────────────

enum Role {
  admin
  manager
  cashier
  accountant
}

enum UserStatus {
  active
  inactive
}

model User {
  id               String       @id @default(uuid())
  name             String
  username         String       @unique
  email            String       @unique
  passwordHash     String
  pin              String
  role             Role         @default(cashier)
  status           UserStatus   @default(active)
  phone            String?
  branch           String?
  twoFactorEnabled Boolean      @default(false)
  organizationId   String       @default("st_001")
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sales            Sale[]
  deliveries       FuelDelivery[]
  auditLogs        AuditLog[]
  shifts           Shift[]

  @@index([organizationId])
  @@index([username])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ── 2. TANKS & TELEMETRY ─────────────────────────────────

enum FuelType {
  PMS
  AGO
  DPK
  LPG
}

enum TankStatus {
  normal
  low
  critical
}

model Tank {
  id             String       @id @default(uuid())
  organizationId String       @default("st_001")
  tankNumber     String
  fuelType       FuelType
  name           String
  unit           String       @default("litres") // litres for PMS/AGO/DPK, kg/cylinder for LPG
  capacity       Float
  currentLevel   Float
  unitPrice      Float
  minThreshold   Float
  status         TankStatus   @default(normal)
  lastCalibrated DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales          Sale[]
  deliveries     FuelDelivery[]
  movements      InventoryMovement[]

  @@unique([organizationId, tankNumber])
  @@index([organizationId])
}

// ── 3. SALES & TRANSACTIONS (POS) ─────────────────────────

enum PaymentMethod {
  cash
  evc
  edahab
  sahal
  card
  credit
}

enum PaymentStatus {
  paid
  pending
  voided
}

enum SyncStatus {
  synced
  pending_local
  pending_cloud
  conflict
}

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique
  stationId     String        // Organization / Station ID
  deviceId      String        @default("main_pos")
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  cashierName   String?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String?
  fuelType      FuelType
  tankId        String
  tank          Tank          @relation(fields: [tankId], references: [id])
  litres        Float
  unitPrice     Float
  totalAmount   Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(paid)
  voidReason    String?
  voidedBy      String?
  voidedAt      DateTime?
  syncStatus    SyncStatus    @default(synced)
  createdAt     DateTime      @default(now())

  @@index([stationId])
  @@index([cashierId])
  @@index([createdAt])
}

// ── 4. DELIVERIES & INVENTORY MOVEMENTS ───────────────────

model FuelDelivery {
  id             String    @id @default(uuid())
  organizationId String    @default("st_001")
  tankId         String
  tank           Tank      @relation(fields: [tankId], references: [id])
  fuelType       FuelType
  litres         Float
  costPerLitre   Float
  totalCost      Float
  supplier       String
  invoiceNumber  String
  receivedById   String
  receivedBy     User      @relation(fields: [receivedById], references: [id])
  dipstickBefore Float?
  dipstickAfter  Float?
  receivedAt     DateTime  @default(now())

  @@index([organizationId])
  @@index([tankId])
}

enum MovementType {
  sale
  delivery
  adjustment
  loss
}

model InventoryMovement {
  id             String       @id @default(uuid())
  organizationId String       @default("st_001")
  tankId         String
  tank           Tank         @relation(fields: [tankId], references: [id])
  fuelType       FuelType
  type           MovementType
  quantity       Float
  previousLevel  Float
  newLevel       Float
  referenceId    String
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([tankId])
}

// ── 5. CUSTOMERS & CREDIT LEDGER ─────────────────────────

model Customer {
  id             String            @id @default(uuid())
  organizationId String            @default("st_001")
  name           String
  phone          String
  email          String?
  company        String?
  creditLimit    Float             @default(500)
  currentBalance Float             @default(0)
  status         String            @default("active") // active, suspended
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sales          Sale[]
  payments       CustomerPayment[]

  @@index([organizationId])
  @@index([phone])
}

model CustomerPayment {
  id             String        @id @default(uuid())
  organizationId String        @default("st_001")
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  customerName   String?
  amount         Float
  paymentMethod  PaymentMethod
  reference      String?
  collectedBy    String
  note           String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([customerId])
}

// ── 6. FINANCE & EXPENSES ────────────────────────────────

model Expense {
  id             String        @id @default(uuid())
  organizationId String        @default("st_001")
  category       String        // Maintenance, Electricity, Salaries, Rent, Office Supplies, Taxes, Other
  description    String
  amount         Float
  addedBy        String
  paymentMethod  PaymentMethod @default(cash)
  receiptNumber  String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

// ── 7. EMPLOYEES, SHIFTS & RECONCILIATION ────────────────

model Shift {
  id              String    @id @default(uuid())
  organizationId  String    @default("st_001")
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  shiftNumber     Int       @default(1)
  startTime       DateTime  @default(now())
  endTime         DateTime?
  openingCash     Float     @default(0)
  closingCash     Float?
  expectedCash    Float?
  cashDiscrepancy Float?
  status          String    @default("open") // open, closed
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
}

// ── 8. AUDIT LOGS, STATION CONFIG & IDEMPOTENCY ──────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @default("st_001")
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  userName       String
  action         String
  details        String
  ipAddress      String?
  deviceId       String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model StationConfig {
  id             String   @id @default(uuid())
  name           String
  branch         String
  address        String
  phone          String
  taxRate        Float    @default(0)
  currency       String   @default("USD")
  currencySymbol String   @default("$")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IdempotencyKey {
  key            String   @id
  organizationId String
  response       String
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model SyncQueueEvent {
  id             String     @id @default(uuid())
  organizationId String     @default("st_001")
  entityType     String
  entityId       String
  action         String
  payload        String
  syncStatus     SyncStatus @default(pending_local)
  createdAt      DateTime   @default(now())

  @@index([organizationId])
}

// GasFlow Petroleum Station Management System — Enterprise Prisma Schema
// Supports PostgreSQL (Production / Cloud Sync) and Local SQLite Station Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "sqlite" for standalone edge kiosk
  url      = env("DATABASE_URL")
}

// ── 1. USERS & ACCESS CONTROL ─────────────────────────────

enum Role {
  admin
  manager
  cashier
  accountant
}

enum UserStatus {
  active
  inactive
}

model User {
  id               String       @id @default(uuid())
  name             String
  username         String       @unique
  email            String       @unique
  passwordHash     String
  pin              String
  role             Role         @default(cashier)
  status           UserStatus   @default(active)
  phone            String?
  branch           String?
  twoFactorEnabled Boolean      @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sales            Sale[]
  deliveries       FuelDelivery[]
  auditLogs        AuditLog[]
  shifts           Shift[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

// ── 2. TANKS & TELEMETRY ─────────────────────────────────

enum FuelType {
  PMS
  AGO
  DPK
  LPG
}

enum TankStatus {
  normal
  low
  critical
}

model Tank {
  id             String       @id @default(uuid())
  tankNumber     String       @unique
  fuelType       FuelType
  name           String
  capacity       Float
  currentLevel   Float
  unitPrice      Float
  minThreshold   Float
  status         TankStatus   @default(normal)
  lastCalibrated DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales          Sale[]
  deliveries     FuelDelivery[]
  movements      InventoryMovement[]
}

// ── 3. SALES & TRANSACTIONS (POS) ─────────────────────────

enum PaymentMethod {
  cash
  evc
  edahab
  sahal
  card
  credit
}

enum PaymentStatus {
  paid
  pending
  voided
}

enum SyncStatus {
  synced
  pending_local
  pending_cloud
  conflict
}

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique
  stationId     String
  deviceId      String
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  fuelType      FuelType
  tankId        String
  tank          Tank          @relation(fields: [tankId], references: [id])
  litres        Float
  unitPrice     Float
  totalAmount   Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(paid)
  voidReason    String?
  voidedBy      String?
  voidedAt      DateTime?
  syncStatus    SyncStatus    @default(synced)
  createdAt     DateTime      @default(now())
}

// ── 4. DELIVERIES & INVENTORY MOVEMENTS ───────────────────

model FuelDelivery {
  id             String    @id @default(uuid())
  tankId         String
  tank           Tank      @relation(fields: [tankId], references: [id])
  fuelType       FuelType
  litres         Float
  costPerLitre   Float
  totalCost      Float
  supplier       String
  invoiceNumber  String
  receivedById   String
  receivedBy     User      @relation(fields: [receivedById], references: [id])
  receivedAt     DateTime  @default(now())
  dipstickBefore Float?
  dipstickAfter  Float?
}

enum MovementType {
  sale
  delivery
  adjustment
  loss
}

model InventoryMovement {
  id            String       @id @default(uuid())
  tankId        String
  tank          Tank         @relation(fields: [tankId], references: [id])
  fuelType      FuelType
  type          MovementType
  quantity      Float
  previousLevel Float
  newLevel      Float
  referenceId   String
  note          String?
  createdAt     DateTime     @default(now())
}

// ── 5. CUSTOMERS & CREDIT LEDGER ─────────────────────────

model Customer {
  id             String            @id @default(uuid())
  name           String
  phone          String
  email          String?
  company        String?
  creditLimit    Float             @default(500)
  currentBalance Float             @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sales          Sale[]
  payments       CustomerPayment[]
}

model CustomerPayment {
  id            String        @id @default(uuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Float
  paymentMethod PaymentMethod
  reference     String?
  receivedBy    String
  note          String?
  createdAt     DateTime      @default(now())
}

// ── 6. FINANCE & EXPENSES ────────────────────────────────

enum ExpenseCategory {
  fuel_purchase
  generator
  electricity
  staff_salary
  maintenance
  taxes_licenses
  station_supplies
  other
}

model Expense {
  id            String          @id @default(uuid())
  title         String
  category      ExpenseCategory
  amount        Float
  paymentMethod PaymentMethod
  recipient     String
  approvedBy    String
  note          String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())
}

// ── 7. EMPLOYEES, SHIFTS & RECONCILIATION ────────────────

model Shift {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  shiftNumber     Int       @default(1)
  startTime       DateTime  @default(now())
  endTime         DateTime?
  openingCash     Float     @default(0)
  closingCash     Float?
  expectedCash    Float?
  cashDiscrepancy Float?
  status          String    @default("open") // open, closed
  createdAt       DateTime  @default(now())
}

// ── 8. AUDIT LOGS & STATION SETTINGS ─────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  action    String
  details   String
  ipAddress String?
  deviceId  String?
  createdAt DateTime @default(now())
}

model StationConfig {
  id             String   @id @default(uuid())
  name           String
  branch         String
  address        String
  phone          String
  taxRate        Float    @default(0)
  currency       String   @default("USD")
  currencySymbol String   @default("$")
  updatedAt      DateTime @updatedAt
}

model SyncQueueEvent {
  id         String     @id @default(uuid())
  entityType String
  entityId   String
  action     String
  payload    String
  syncStatus SyncStatus @default(pending_local)
  createdAt  DateTime   @default(now())
}
